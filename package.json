    "@remix-run/serve": "^2.16.0",
    "@types/axios": "^0.14.4",
    "axios": "^1.9.0",
    "isbot": "^4.1.0",
    "langchain": "^0.1.21",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.2",
    "mupdf": "^1.3.6",
    "openai": "^7.43.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.2.133",
    "pg": "^8.15.6",
    "pgvector": "^0.2.0",
